# ===== 基础 =====
# 站点对外可访问地址（用于支付回调 notify_url，必须公网可达 + HTTPS + 已 ICP 备案域名）
SITE_BASE_URL=https://your-domain.com
PORT=3000

# 支付方式开关：mock 表示本地模拟支付（无需商户号即可跑通全链路）
# 可选值：mock | wechat | alipay | all
PAYMENT_MODE=mock

# ===== 微信支付 V3 =====
WECHAT_MCH_ID=
WECHAT_APP_ID=
# 商户 API 私钥（PKCS#8 PEM 文本内容，或指向文件）
WECHAT_MCH_PRIVATE_KEY=
WECHAT_MCH_PRIVATE_KEY_FILE=
# APIv3 密钥（32 字节，用于回调报文解密）
WECHAT_API_V3_KEY=
# 微信平台证书序列号（请求头 serial_number）
WECHAT_SERIAL_NO=
# 微信平台公钥（PEM，用于验证回调签名）
WECHAT_PLATFORM_PUBLIC_KEY=

# ===== 支付宝 =====
ALIPAY_APP_ID=
# 应用私钥（PKCS#8 PEM）
ALIPAY_APP_PRIVATE_KEY=
# 支付宝公钥（PEM，用于验证回调签名）
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

# ===== 商品类目（影响支付费率，见 README）=====
# 一般实物小商品 0.6%；特殊类目（游戏/网络广告等）1%
MERCHANT_CATEGORY=general
